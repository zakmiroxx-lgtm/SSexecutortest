-- SERVER SCANNER

local function ScanServer()
    State.ServerAvailable = false
    State.Authorized = false
    State.Remote = nil

    StatusLabel.Text = "SS STATUS: SCANNING..."
    StatusLabel.TextColor3 = CONFIG.Warning

    AccessLabel.Text = "SERVER ACCESS: UNKNOWN"

    local folder = ReplicatedStorage:FindFirstChild("UniversalSS")

    if not folder then
        StatusLabel.Text = "SS STATUS: NOT INSTALLED"
        StatusLabel.TextColor3 = CONFIG.Error

        Notify("Compatible server module not found")
        return false
    end

    local remote = folder:FindFirstChild("ExecuteRemote")

    if not remote or not remote:IsA("RemoteEvent") then
        StatusLabel.Text = "SS STATUS: REMOTE NOT FOUND"
        StatusLabel.TextColor3 = CONFIG.Error

        Notify("Compatible RemoteEvent not found")
        return false
    end

    State.Remote = remote
    State.ServerAvailable = true

    StatusLabel.Text = "SS STATUS: REMOTE DETECTED"
    StatusLabel.TextColor3 = CONFIG.Warning

    Notify("Server endpoint detected")

    return true
end

-- REQUEST / RESPONSE

local function RequestServer(action)
    if not State.Remote then
        return false
    end

    State.RequestId += 1

    local id = State.RequestId

    State.Pending[id] = {
        Completed = false,
        Result = nil
    }

    State.Remote:FireServer({
        Action = action,
        RequestId = id
    })

    local started = os.clock()

    while os.clock() - started < 5 do
        local request = State.Pending[id]

        if request and request.Completed then
            local result = request.Result

            State.Pending[id] = nil

            return result
        end

        task.wait(0.05)
    end

    State.Pending[id] = nil

    return false
end

local ConnectedRemote

local function ConnectResponses()
    if ConnectedRemote then
        ConnectedRemote:Disconnect()
        ConnectedRemote = nil
    end

    if not State.Remote then
        return
    end

    ConnectedRemote = State.Remote.OnClientEvent:Connect(function(data)
        if typeof(data) ~= "table" then
            return
        end

        local request = State.Pending[data.RequestId]

        if request then
            request.Completed = true
            request.Result = data
        end
    end)
end

-- ACCESS CHECK

local function CheckAccess()
    if not ScanServer() then
        return
    end

    ConnectResponses()

    AccessLabel.Text = "SERVER ACCESS: CHECKING..."

    local response = RequestServer("CheckAccess")

    if not response then
        AccessLabel.Text = "SERVER ACCESS: NO RESPONSE"
        AccessLabel.TextColor3 = CONFIG.Error

        Notify("Server did not respond")
        return
    end

    if response.Authorized == true then
        State.Authorized = true

        StatusLabel.Text = "SS STATUS: ONLINE"
        StatusLabel.TextColor3 = CONFIG.Success

        AccessLabel.Text = "SERVER ACCESS: GRANTED"
        AccessLabel.TextColor3 = CONFIG.Success

        Notify("Server access granted")
    else
        State.Authorized = false

        AccessLabel.Text = "SERVER ACCESS: DENIED"
        AccessLabel.TextColor3 = CONFIG.Error

        Notify("Server access denied")
    end
end

