-- CLIENT COMMANDS

local ClientCommands = {}

ClientCommands.heal = function()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.Health = humanoid.MaxHealth
    end
end

ClientCommands.speed = function()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = 32
    end
end

ClientCommands.normal = function()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = 16
    end
end

ClientCommands.jump = function()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = 100
    end
end

-- EXECUTION

ExecuteButton.MouseButton1Click:Connect(function()
    local command = Editor.Text:match("^%s*(.-)%s*$")

    if command == "" then
        Notify("Editor is empty")
        return
    end

    if State.Mode == "Client" then
        local action = ClientCommands[command]

        if not action then
            Notify("Unknown client command")
            return
        end

        local success, err = pcall(action)

        if success then
            Notify("Client command executed")
        else
            warn(err)
            Notify("Client execution failed")
        end

        return
    end

    if not State.ServerAvailable then
        Notify("Server unavailable")
        return
    end

    if not State.Authorized then
        Notify("Server access not granted")
        return
    end

    if not State.Remote then
        Notify("Remote disconnected")
        return
    end

    State.Remote:FireServer({
        Action = "ExecuteCommand",
        Command = command
    })

    Notify("Server command sent")
end)

