end)

local ClientCommands = {}

ClientCommands.heal = function()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.Health = humanoid.MaxHealth
    end
end

ClientCommands.speed = function()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = 32
    end
end

ClientCommands.normal = function()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = 16
    end
end

ClientCommands.jump = function()
    local character = Player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = 100
    end
end

Execute.MouseButton1Click:Connect(function()
    local command = Editor.Text:match("^%s*(.-)%s*$")

    if command == "" then
        Notify("Editor is empty")
        return
    end

    if Mode == "Client" then
        local action = ClientCommands[command]

        if not action then
            Notify("Unknown client command")
            return
        end

        local success, err = pcall(action)

        if success then
            Notify("Client command executed")
        else
            warn("[Universal SS]", err)
            Notify("Execution failed")
        end
    else
        if Remote and Remote:IsA("RemoteEvent") then
            Remote:FireServer(command)
            Notify("Server command sent")
        else
            Notify("ServerSide unavailable")
        end
    end
end)

Clear.MouseButton1Click:Connect(function()
